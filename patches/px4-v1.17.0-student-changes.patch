+class FailsafeStudentTester : public FailsafeBase
+{
+public:
+	FailsafeStudentTester(ModuleParams *parent = nullptr) : FailsafeBase(parent) {}
+
+	using StateCheckFn = std::function<void(FailsafeStudentTester *, const hrt_abstime &, const State &, const failsafe_flags_s &)>;
+	using FallbackCheckFn = std::function<Action(const failsafe_flags_s &, uint8_t)>;
+
+	void setStateCheckCallback(StateCheckFn fn) { _state_check_fn = fn; }
+	void setFallbackCheckCallback(FallbackCheckFn fn) { _fallback_check_fn = fn; }
+
+	// Test seam helpers to invoke protected members
+	bool callCheckFailsafe(int caller_id, bool last_state_failure, bool cur_state_failure, const ActionOptions &options)
+	{
+		return checkFailsafe(caller_id, last_state_failure, cur_state_failure, options);
+	}
+
+	int callGenCallerId() { return genCallerId(); }
+
+	static bool callModeCanRun(const failsafe_flags_s &status_flags, uint8_t mode)
+	{
+		return modeCanRun(status_flags, mode);
+	}
+
+	void callClearDelayIfNeeded(const State &state, const failsafe_flags_s &status_flags)
+	{
+		clearDelayIfNeeded(state, status_flags);
+	}
+
+	void callGetSelectedAction(const State &state, const failsafe_flags_s &status_flags,
+				   bool user_intended_mode_updated, bool rc_sticks_takeover_request,
+				   SelectedActionState &returned_state) const
+	{
+		getSelectedAction(state, status_flags, user_intended_mode_updated, rc_sticks_takeover_request, returned_state);
+	}
+
+	void callRemoveAction(ActionOptions &action) const
+	{
+		removeAction(action);
+	}
+
+	void callRemoveNonActivatedActions()
+	{
+		removeNonActivatedActions();
+	}
+
+	void callUpdateStartDelay(const hrt_abstime &dt, bool delay_active)
+	{
+		updateStartDelay(dt, delay_active);
+	}
+
+	void callUpdateDelay(const hrt_abstime &elapsed_us)
+	{
+		updateDelay(elapsed_us);
+	}
+
+	ActionOptions &getActionSlot(int idx) { return _actions[idx]; }
+	hrt_abstime getCurrentStartDelay() const { return _current_start_delay; }
+	hrt_abstime getCurrentDelay() const { return _current_delay; }
+	void setCurrentDelay(hrt_abstime delay) { _current_delay = delay; }
+	void setSelectedActionDirect(Action act) { _selected_action = act; }
+	void setUserTakeoverActiveDirect(bool active) { _user_takeover_active = active; }
+
+protected:
+	void checkStateAndMode(const hrt_abstime &time_us, const State &state,
+			       const failsafe_flags_s &status_flags) override
+	{
+		if (_state_check_fn) {
+			_state_check_fn(this, time_us, state, status_flags);
+		}
+	}
+
+	Action checkModeFallback(const failsafe_flags_s &status_flags, uint8_t user_intended_mode) const override
+	{
+		if (_fallback_check_fn) {
+			return _fallback_check_fn(status_flags, user_intended_mode);
+		}
+
+		return Action::None;
+	}
+
+private:
+	StateCheckFn _state_check_fn{nullptr};
+	FallbackCheckFn _fallback_check_fn{nullptr};
+};
