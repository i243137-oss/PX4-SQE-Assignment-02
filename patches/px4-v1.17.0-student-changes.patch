+// ============================================================================
+// TC-FS-26: Delay clearing causes in clearDelayIfNeeded
+// Obligation: OBL-FS-027
+// ============================================================================
+TEST_F(FailsafeStudentTest, TC_FS_26_DelayClearingCauses)
+{
+	failsafe_flags_s flags{};
+
+	// Cause 1: _selected_action > Action::Hold (e.g. RTL)
+	{
+		FailsafeStudentTester failsafe;
+		failsafe.setCurrentDelay(5_s);
+		failsafe.setSelectedActionDirect(FailsafeBase::Action::RTL);
+		failsafe.callClearDelayIfNeeded(_default_state, flags);
+		EXPECT_EQ(failsafe.getCurrentDelay(), 0_s);
+	}
+
+	// Cause 2: AUTO_LOITER (Hold) cannot run
+	{
+		FailsafeStudentTester failsafe;
+		failsafe.setCurrentDelay(5_s);
+		failsafe.setSelectedActionDirect(FailsafeBase::Action::Hold);
+
+		failsafe_flags_s bad_flags = flags;
+		bad_flags.local_position_invalid = true;
+		bad_flags.mode_req_local_position = (1u << vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER);
+
+		failsafe.callClearDelayIfNeeded(_default_state, bad_flags);
+		EXPECT_EQ(failsafe.getCurrentDelay(), 0_s);
+	}
+
+	// Cause 3: _user_takeover_active == true
+	{
+		FailsafeStudentTester failsafe;
+		failsafe.setCurrentDelay(5_s);
+		failsafe.setSelectedActionDirect(FailsafeBase::Action::Hold);
+		failsafe.setUserTakeoverActiveDirect(true);
+		failsafe.callClearDelayIfNeeded(_default_state, flags);
+		EXPECT_EQ(failsafe.getCurrentDelay(), 0_s);
+	}
+
+	// Normal case: delay retained
+	{
+		FailsafeStudentTester failsafe;
+		failsafe.setCurrentDelay(5_s);
+		failsafe.setSelectedActionDirect(FailsafeBase::Action::Hold);
+		failsafe.setUserTakeoverActiveDirect(false);
+		failsafe.callClearDelayIfNeeded(_default_state, flags);
+		EXPECT_EQ(failsafe.getCurrentDelay(), 5_s);
+	}
+}
