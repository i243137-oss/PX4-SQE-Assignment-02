+// ============================================================================
+// TC-FS-08: Delay reduction, zero threshold, regrowth, and cap
+// Obligation: OBL-FS-009
+// ============================================================================
+TEST_F(FailsafeStudentTest, TC_FS_08_StartDelayReductionRegrowthCap)
+{
+	FailsafeStudentTester failsafe;
+	// COM_FAIL_ACT_T is 5.0s, so configured delay is 5_s
+	EXPECT_EQ(failsafe.getCurrentStartDelay(), 5_s);
+
+	// Reduce delay with dt < current (dt = 1s)
+	failsafe.callUpdateStartDelay(1_s, true);
+	EXPECT_EQ(failsafe.getCurrentStartDelay(), 4_s);
+
+	// Reduce to zero with dt >= current (dt = 4s)
+	failsafe.callUpdateStartDelay(4_s, true);
+	EXPECT_EQ(failsafe.getCurrentStartDelay(), 0_s);
+
+	// Regrowth with delay_active = false: increases by dt / 4
+	failsafe.callUpdateStartDelay(4_s, false);
+	EXPECT_EQ(failsafe.getCurrentStartDelay(), 1_s);
+
+	// Cap at configured parameter (5_s)
+	failsafe.callUpdateStartDelay(40_s, false);
+	EXPECT_EQ(failsafe.getCurrentStartDelay(), 5_s);
+}
