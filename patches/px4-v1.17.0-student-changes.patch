+// ============================================================================
+// TC-FS-11: Auto takeover parameter thresholds and Warn delay suppression
+// Obligation: OBL-FS-012
+// ============================================================================
+TEST_F(FailsafeStudentTest, TC_FS_11_AutoTakeoverThresholds)
+{
+	// COM_FAIL_ACT_T > 0.1f -> Always policy, delay starts
+	{
+		FailsafeStudentTester failsafe;
+		FailsafeBase::ActionOptions opt(FailsafeBase::Action::RTL);
+		opt.allowUserTakeover(FailsafeBase::UserTakeoverAllowed::Auto);
+		failsafe.callCheckFailsafe(301, false, true, opt);
+		EXPECT_EQ(failsafe.getActionSlot(0).allow_user_takeover, FailsafeBase::UserTakeoverAllowed::Always);
+		EXPECT_GT(failsafe.getCurrentDelay(), 0_s);
+	}
+
+	// COM_FAIL_ACT_T <= 0.1f -> AlwaysModeSwitchOnly policy
+	{
+		param_t p = param_handle(px4::params::COM_FAIL_ACT_T);
+		float val = 0.1f;
+		param_set(p, &val);
+
+		FailsafeStudentTester failsafe;
+		failsafe.setCurrentDelay(0);
+		FailsafeBase::ActionOptions opt(FailsafeBase::Action::RTL);
+		opt.allowUserTakeover(FailsafeBase::UserTakeoverAllowed::Auto);
+		failsafe.callCheckFailsafe(302, false, true, opt);
+		EXPECT_EQ(failsafe.getActionSlot(0).allow_user_takeover, FailsafeBase::UserTakeoverAllowed::AlwaysModeSwitchOnly);
+		EXPECT_EQ(failsafe.getCurrentDelay(), 0_s);
+
+		// Reset param back to 5.0f
+		val = 5.0f;
+		param_set(p, &val);
+	}
+
+	// Warn action never starts delay
+	{
