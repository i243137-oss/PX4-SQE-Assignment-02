+// ============================================================================
+// TC-FS-05: Mode-change clears OnModeChangeOrDisarm actions
+// Obligation: OBL-FS-005
+// ============================================================================
+TEST_F(FailsafeStudentTest, TC_FS_05_ModeChangeCleanup)
+{
+	FailsafeStudentTester failsafe;
+	failsafe_flags_s flags{};
+	const int caller_id = 102;
+	bool active_failure = true;
+
+	failsafe.setStateCheckCallback([&](FailsafeStudentTester *fs, const hrt_abstime &, const FailsafeBase::State &, const failsafe_flags_s &) {
+		ActionOptions opts(FailsafeBase::Action::RTL);
+		opts.clearOn(ClearCondition::OnModeChangeOrDisarm);
+		fs->callCheckFailsafe(caller_id, false, active_failure, opts);
+	});
+
+	hrt_abstime time = 1_s;
+	_default_state.user_intended_mode = vehicle_status_s::NAVIGATION_STATE_POSCTL;
+	failsafe.update(time, _default_state, false, false, flags);
+
+	// Condition cleared, slot retained waiting for mode switch
+	active_failure = false;
+	time += 10_ms;
+	failsafe.update(time, _default_state, false, false, flags);
+
+	// Mode changed without setting user_intended_mode_updated explicitly
+	_default_state.user_intended_mode = vehicle_status_s::NAVIGATION_STATE_ALTCTL;
+	time += 10_ms;
+	failsafe.update(time, _default_state, false, false, flags);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::None);
+
+	// Re-trigger and test explicit user_intended_mode_updated=true with same mode
+	active_failure = true;
+	time += 10_ms;
+	failsafe.update(time, _default_state, false, false, flags);
+	active_failure = false;
+	time += 10_ms;
+	failsafe.update(time, _default_state, false, false, flags);
+
+	time += 10_ms;
+	failsafe.update(time, _default_state, true, false, flags);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::None);
+}
