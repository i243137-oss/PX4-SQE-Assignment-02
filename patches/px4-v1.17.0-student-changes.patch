+// ============================================================================
+// TC-FS-04: Arming and disarming transitions clear OnDisarm/OnModeChangeOrDisarm
+// Obligation: OBL-FS-004
+// ============================================================================
+TEST_F(FailsafeStudentTest, TC_FS_04_ArmingDisarmingTransitionCleanup)
+{
+	FailsafeStudentTester failsafe;
+	failsafe_flags_s flags{};
+	const int caller_id = 101;
+	bool active_failure = true;
+
+	failsafe.setStateCheckCallback([&](FailsafeStudentTester *fs, const hrt_abstime &, const FailsafeBase::State &, const failsafe_flags_s &) {
+		ActionOptions opts(FailsafeBase::Action::RTL);
+		opts.clearOn(ClearCondition::OnModeChangeOrDisarm);
+		opts.allowUserTakeover(UserTakeoverAllowed::Never);
+		fs->callCheckFailsafe(caller_id, false, active_failure, opts);
+	});
+
+	hrt_abstime time = 1_s;
+	_default_state.armed = true;
+	failsafe.update(time, _default_state, false, false, flags);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::RTL);
+
+	// Condition clears, but action is OnModeChangeOrDisarm so it remains retained
+	active_failure = false;
+	time += 10_ms;
+	failsafe.update(time, _default_state, false, false, flags);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::RTL);
+
+	// Disarm transition (armed: true -> false)
+	_default_state.armed = false;
+	time += 10_ms;
+	failsafe.update(time, _default_state, false, false, flags);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::None);
+	EXPECT_FALSE(failsafe.userTakeoverActive());
+
+	// Arming transition (armed: false -> true)
+	time += 10_ms;
+	_default_state.armed = true;
+	failsafe.update(time, _default_state, false, false, flags);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::None);
+}
