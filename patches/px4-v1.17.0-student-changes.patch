+		_default_state.user_intended_mode = vehicle_status_s::NAVIGATION_STATE_POSCTL;
+		_default_state.vehicle_type = vehicle_status_s::VEHICLE_TYPE_ROTARY_WING;
+		_default_state.vtol_in_transition_mode = false;
+		_default_state.mission_finished = false;
+	}
+
+protected:
+	FailsafeBase::State _default_state{};
+};
