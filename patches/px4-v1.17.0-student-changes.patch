+// ============================================================================
+// TC-FS-07: User notification callback and notification_required reset
+// Obligation: OBL-FS-008, OBL-FS-012
+// ============================================================================
+TEST_F(FailsafeStudentTest, TC_FS_07_NotificationCallbackAndReset)
+{
+	FailsafeStudentTester failsafe;
+	failsafe_flags_s flags{};
+	const int caller_id = 104;
+
+	static int notify_count = 0;
+	notify_count = 0;
+	failsafe.setOnNotifyUserCallback([](void *) { notify_count++; }, nullptr);
+
+	failsafe.setStateCheckCallback([&](FailsafeStudentTester *fs, const hrt_abstime &, const FailsafeBase::State &, const failsafe_flags_s &) {
+		ActionOptions opts(FailsafeBase::Action::Warn);
+		opts.clearOn(ClearCondition::WhenConditionClears);
+		fs->callCheckFailsafe(caller_id, false, true, opts);
+	});
