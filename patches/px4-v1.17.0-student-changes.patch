+// TC-FS-11: Auto takeover parameter thresholds and Warn delay suppression
+// Obligation: OBL-FS-012
+// ============================================================================
+TEST_F(FailsafeStudentTest, TC_FS_11_AutoTakeoverThresholds)
+{
+	// COM_FAIL_ACT_T > 0.1f -> Always policy, delay starts
+	{
+		FailsafeStudentTester failsafe;
+		ActionOptions opt(FailsafeBase::Action::RTL);
+		opt.allowUserTakeover(UserTakeoverAllowed::Auto);
+		failsafe.callCheckFailsafe(301, false, true, opt);
+		int slot = failsafe.findActionSlot(301);
