+
+		failsafe_flags_s unavail_flags = flags;
+		unavail_flags.attitude_invalid = true;
+		unavail_flags.mode_req_attitude = (1u << vehicle_status_s::NAVIGATION_STATE_AUTO_LAND);
+
+		FailsafeBase::ActionOptions opt(FailsafeBase::Action::RTL);
+		opt.allowUserTakeover(FailsafeBase::UserTakeoverAllowed::Never);
+		failsafe.callCheckFailsafe(1302, false, true, opt);
+
+		FailsafeBase::SelectedActionState ret{};
+		failsafe.callGetSelectedAction(state, unavail_flags, false, false, ret);
+		EXPECT_EQ(ret.action, FailsafeBase::Action::RTL);
+	}
+}
