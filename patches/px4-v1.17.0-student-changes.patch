+		param_set(p, &val);
+
+		FailsafeStudentTester failsafe;
+		failsafe.setCurrentDelay(0);
+		ActionOptions opt(FailsafeBase::Action::RTL);
+		opt.allowUserTakeover(UserTakeoverAllowed::Auto);
