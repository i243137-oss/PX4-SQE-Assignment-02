+		EXPECT_GT(failsafe.getCurrentDelay(), 0_s);
+	}
+
+	// COM_FAIL_ACT_T <= 0.1f -> AlwaysModeSwitchOnly policy
+	{
+		param_t p = param_handle(px4::params::COM_FAIL_ACT_T);
+		float val = 0.1f;
+		param_set(p, &val);
+
+		FailsafeStudentTester failsafe;
+		failsafe.setCurrentDelay(0);
+		ActionOptions opt(FailsafeBase::Action::RTL);
+		opt.allowUserTakeover(UserTakeoverAllowed::Auto);
+		failsafe.callCheckFailsafe(302, false, true, opt);
+		int slot = failsafe.findActionSlot(302);
+		ASSERT_GE(slot, 0);
+		EXPECT_EQ(failsafe.getActionSlot(slot).allow_user_takeover, UserTakeoverAllowed::AlwaysModeSwitchOnly);
+		EXPECT_EQ(failsafe.getCurrentDelay(), 0_s);
+
+		// Reset param back to 5.0f
+		val = 5.0f;
+		param_set(p, &val);
+	}
+
+	// Warn action never starts delay
+	{
+		FailsafeStudentTester failsafe;
+		failsafe.setCurrentDelay(0);
+		ActionOptions opt(FailsafeBase::Action::Warn);
+		opt.allowUserTakeover(UserTakeoverAllowed::Auto);
+		failsafe.callCheckFailsafe(303, false, true, opt);
+		EXPECT_EQ(failsafe.getCurrentDelay(), 0_s);
+	}
+}
