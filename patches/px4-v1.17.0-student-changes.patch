+	EXPECT_FALSE(opt2.state_failure);
+
+	// While deferring, deferrable action is removed immediately despite retained condition
+	failsafe.deferFailsafes(true, 10);
+	ActionOptions opt3(FailsafeBase::Action::RTL);
+	opt3.clearOn(ClearCondition::OnModeChangeOrDisarm);
+	opt3.can_be_deferred = true;
+	opt3.id = 504;
+	opt3.state_failure = true;
+	failsafe.callRemoveAction(opt3);
+	EXPECT_FALSE(opt3.valid());
