+// ============================================================================
+// TC-FS-02: Public mapping - modeFromAction for mode and non-mode actions
+// Obligation: OBL-FS-002
+// ============================================================================
+TEST_F(FailsafeStudentTest, TC_FS_02_ModeFromActionMappings)
+{
+	const uint8_t sentinel_mode = vehicle_status_s::NAVIGATION_STATE_MANUAL;
+
+	// Mode-producing actions
+	EXPECT_EQ(FailsafeBase::modeFromAction(FailsafeBase::Action::FallbackPosCtrl, sentinel_mode),
+		  vehicle_status_s::NAVIGATION_STATE_POSCTL);
+	EXPECT_EQ(FailsafeBase::modeFromAction(FailsafeBase::Action::FallbackAltCtrl, sentinel_mode),
+		  vehicle_status_s::NAVIGATION_STATE_ALTCTL);
+	EXPECT_EQ(FailsafeBase::modeFromAction(FailsafeBase::Action::FallbackStab, sentinel_mode),
+		  vehicle_status_s::NAVIGATION_STATE_STAB);
+	EXPECT_EQ(FailsafeBase::modeFromAction(FailsafeBase::Action::Hold, sentinel_mode),
+		  vehicle_status_s::NAVIGATION_STATE_AUTO_LOITER);
+	EXPECT_EQ(FailsafeBase::modeFromAction(FailsafeBase::Action::RTL, sentinel_mode),
+		  vehicle_status_s::NAVIGATION_STATE_AUTO_RTL);
+	EXPECT_EQ(FailsafeBase::modeFromAction(FailsafeBase::Action::Land, sentinel_mode),
+		  vehicle_status_s::NAVIGATION_STATE_AUTO_LAND);
+	EXPECT_EQ(FailsafeBase::modeFromAction(FailsafeBase::Action::Descend, sentinel_mode),
+		  vehicle_status_s::NAVIGATION_STATE_DESCEND);
+
+	// Non-mode producing actions must preserve supplied mode
+	EXPECT_EQ(FailsafeBase::modeFromAction(FailsafeBase::Action::None, sentinel_mode), sentinel_mode);
+	EXPECT_EQ(FailsafeBase::modeFromAction(FailsafeBase::Action::Warn, sentinel_mode), sentinel_mode);
+	EXPECT_EQ(FailsafeBase::modeFromAction(FailsafeBase::Action::Disarm, sentinel_mode), sentinel_mode);
+	EXPECT_EQ(FailsafeBase::modeFromAction(FailsafeBase::Action::Terminate, sentinel_mode), sentinel_mode);
+	EXPECT_EQ(FailsafeBase::modeFromAction(FailsafeBase::Action::Count, sentinel_mode), sentinel_mode);
+	EXPECT_EQ(FailsafeBase::modeFromAction(static_cast<FailsafeBase::Action>(99), sentinel_mode), sentinel_mode);
+}
