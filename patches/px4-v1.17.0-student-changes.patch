+// ============================================================================
+// TC-FS-14: Retained clear condition and deferral removal override
+// Obligation: OBL-FS-013
+// ============================================================================
+TEST_F(FailsafeStudentTest, TC_FS_14_RetainedClearConditionAndDeferralOverride)
+{
+	FailsafeStudentTester failsafe;
+
+	// OnModeChangeOrDisarm: retained with state_failure = false when not deferring
+	ActionOptions opt1(FailsafeBase::Action::RTL);
+	opt1.clearOn(ClearCondition::OnModeChangeOrDisarm);
+	opt1.id = 502;
+	opt1.state_failure = true;
+	failsafe.callRemoveAction(opt1);
