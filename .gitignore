# Explicitly ignore external repository, build artifacts, and editor temporary files
PX4-Autopilot/
build/
.cache/
.vscode/
.idea/
*.tmp
*.swp
*~
__pycache__/
.DS_Store

# Ignore everything by default
/*

# Whitelist repo files and required deliverable folders
!.gitignore
!/README.md
!/report/
!/report/**
!/analysis/
!/analysis/**
!/design/
!/design/**
!/evidence/
!/evidence/**
!/deliverables/
!/deliverables/**
!/patches/
!/patches/**
!/docs/
!/docs/**
!/workbook/
!/workbook/**
