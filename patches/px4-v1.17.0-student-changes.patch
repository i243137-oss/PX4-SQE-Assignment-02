+	EXPECT_EQ(esc.esc[1].esc_rpm, 0);
+	EXPECT_EQ(esc.esc_online_flags & (1 << 1), 0);
+
+	// Other motors untouched
+	EXPECT_FLOAT_EQ(esc.esc[0].esc_current, 5.0f);
+	EXPECT_FLOAT_EQ(esc.esc[2].esc_current, 5.0f);
+}
