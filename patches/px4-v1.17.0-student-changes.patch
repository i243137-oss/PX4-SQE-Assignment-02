+// FI-13: End-to-end: injected STUCK telemetry leads to motor failure
+TEST_F(FailureDetectorFixture, FiIntegrationStuck)
+{
+	int32_t act_en = 1;
+	param_set(param_find("FD_ACT_EN"), &act_en);
+
+	TestableFailureDetector detector;
+	detector.updateParams();
+
+	vehicle_status_s vehicle_status{};
+	vehicle_status.arming_state = vehicle_status_s::ARMING_STATE_ARMED;
+	vehicle_control_mode_s vehicle_control_mode{};
+
+	// 1. Establish valid telemetry on motor 1
+	esc_status_s esc{};
+	esc.timestamp = hrt_absolute_time();
+	esc.esc_count = 1;
+	esc.esc[0].actuator_function = actuator_motors_s::ACTUATOR_FUNCTION_MOTOR1;
+	esc.esc[0].esc_current = 5.0f;
+	esc.esc[0].timestamp = hrt_absolute_time();
+	publishEscStatus(esc);
+	detector.update(vehicle_status, vehicle_control_mode);
+	EXPECT_EQ(detector.getStatusFlags().motor, 0);
+
+	// 2. Inject STUCK on motor 1
+	publishVehicleCommand(vehicle_command_s::VEHICLE_CMD_INJECT_FAILURE,
+			      vehicle_command_s::FAILURE_UNIT_SYSTEM_MOTOR,
+			      vehicle_command_s::FAILURE_TYPE_STUCK, 1.0f);
+
+	// 3. Keep publishing fresh esc reports: FailureInjector will blank esc[0], timestamp becomes 0!
+	// In FailureDetector: now > 0 + 300ms is TRUE -> timeout triggered!
+	esc.timestamp = hrt_absolute_time();
+	esc.esc[0].timestamp = hrt_absolute_time();
+	esc.esc[0].esc_current = 5.0f;
+	publishEscStatus(esc);
+	detector.update(vehicle_status, vehicle_control_mode);
+
+	EXPECT_EQ(detector.getStatusFlags().motor, 1);
+	EXPECT_EQ(detector.getMotorFailures(), 1);
+}
