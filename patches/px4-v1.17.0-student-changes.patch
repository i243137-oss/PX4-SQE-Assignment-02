+// ============================================================================
+// TC-FS-03: Update timing initialization and state commit
+// Obligation: OBL-FS-003, OBL-FS-008
+// ============================================================================
+TEST_F(FailsafeStudentTest, TC_FS_03_UpdateTimingInitializationAndCommit)
+{
+	FailsafeStudentTester failsafe;
+	failsafe_flags_s flags{};
+
+	hrt_abstime time1 = 5_s;
+	uint8_t mode1 = failsafe.update(time1, _default_state, false, false, flags);
+	EXPECT_EQ(mode1, _default_state.user_intended_mode);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::None);
