+// ============================================================================
+// TC-FS-29: Action removal on failure clear (lines 376-392) & duplicate diagnostic
+// Coverage targets: framework.cpp:376-388
+// ============================================================================
+TEST_F(FailsafeStudentTest, TC_FS_29_CheckFailsafeActionRemovalAndDuplicateCaller)
+{
+	FailsafeStudentTester failsafe;
+	const int caller_id = 150;
+	ActionOptions opt{Action::Hold};
+
+	// 1. Initial trigger: failure occurs (last=false, cur=true)
+	bool ret = failsafe.callCheckFailsafe(caller_id, false, true, opt);
+	EXPECT_TRUE(ret);
+	int slot = failsafe.findActionSlot(caller_id);
+	ASSERT_NE(slot, -1);
+	EXPECT_TRUE(failsafe.getActionSlot(slot).valid());
+	EXPECT_TRUE(failsafe.getActionSlot(slot).state_failure);
+
+	// 2. Failure clears: transition from last=true to cur=false
+	ret = failsafe.callCheckFailsafe(caller_id, true, false, opt);
+	EXPECT_FALSE(ret);
+	EXPECT_EQ(failsafe.findActionSlot(caller_id), -1);
+
+	// 3. Duplicate action in multiple slots during clear transition (lines 382-384)
+	const int dup_caller = 160;
+	failsafe.callCheckFailsafe(dup_caller, false, true, opt);
+	int slot0 = failsafe.findActionSlot(dup_caller);
+	ASSERT_NE(slot0, -1);
+	int slot1 = (slot0 == 0) ? 1 : 0;
+	failsafe.getActionSlot(slot1) = failsafe.getActionSlot(slot0);
+	EXPECT_TRUE(failsafe.getActionSlot(slot1).valid());
+	EXPECT_EQ(failsafe.getActionSlot(slot1).id, dup_caller);
+
+	ret = failsafe.callCheckFailsafe(dup_caller, true, false, opt);
+	EXPECT_FALSE(ret);
+	EXPECT_EQ(failsafe.findActionSlot(dup_caller), -1);
+}
