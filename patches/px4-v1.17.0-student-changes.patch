+// ============================================================================
+// TC-FS-06: Finite and infinite deferral timeout boundaries
+// Obligation: OBL-FS-006, OBL-FS-007
+// ============================================================================
+TEST_F(FailsafeStudentTest, TC_FS_06_FiniteAndInfiniteDeferralTiming)
+{
+	FailsafeStudentTester failsafe;
+	failsafe_flags_s flags{};
+	const int caller_id = 103;
+
+	failsafe.setStateCheckCallback([&](FailsafeStudentTester *fs, const hrt_abstime &, const FailsafeBase::State &, const failsafe_flags_s &) {
+		ActionOptions opts(FailsafeBase::Action::Descend);
+		opts.clearOn(ClearCondition::WhenConditionClears);
+		fs->callCheckFailsafe(caller_id, false, true, opts);
+	});
+
+	EXPECT_TRUE(failsafe.deferFailsafes(true, 2)); // 2 second timeout
+	EXPECT_TRUE(failsafe.getDeferFailsafes());
+
+	hrt_abstime start_t = 10_s;
+	failsafe.update(start_t, _default_state, false, false, flags);
+	EXPECT_TRUE(failsafe.failsafeDeferred());
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::None);
+
+	// Exact timeout boundary (start_t + 2s): not strictly past, deferral still active
+	hrt_abstime exact_t = start_t + 2_s;
+	failsafe.update(exact_t, _default_state, false, false, flags);
+	EXPECT_TRUE(failsafe.getDeferFailsafes());
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::None);
+
+	// Strictly past timeout boundary (start_t + 2s + 1us): deferral clears
+	hrt_abstime past_t = start_t + 2_s + 1_us;
+	failsafe.update(past_t, _default_state, false, false, flags);
+	EXPECT_FALSE(failsafe.getDeferFailsafes());
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Hold);
+
+	// After delay elapses (COM_FAIL_ACT_T = 5s), Descend takes effect
+	failsafe.update(past_t + 6_s, _default_state, false, false, flags);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::Descend);
+
+	// Infinite timeout (-1): never clears automatically (tested on fresh instance where no action is active)
+	FailsafeStudentTester failsafe_inf;
+	failsafe_inf.setStateCheckCallback([&](FailsafeStudentTester *fs, const hrt_abstime &, const FailsafeBase::State &, const failsafe_flags_s &) {
+		ActionOptions opts(FailsafeBase::Action::Descend);
+		opts.clearOn(ClearCondition::WhenConditionClears);
+		fs->callCheckFailsafe(caller_id, false, true, opts);
+	});
+	EXPECT_TRUE(failsafe_inf.deferFailsafes(true, -1));
+	hrt_abstime inf_t = 30_s;
+	failsafe_inf.update(inf_t, _default_state, false, false, flags);
+	EXPECT_TRUE(failsafe_inf.failsafeDeferred());
+	failsafe_inf.update(inf_t + 100_s, _default_state, false, false, flags);
+	EXPECT_TRUE(failsafe_inf.getDeferFailsafes());
+}
