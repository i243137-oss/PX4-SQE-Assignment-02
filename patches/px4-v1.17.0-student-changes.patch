+	// 1. Line 320: Multiple duplicates in same instance
+	{
+		FailsafeStudentTester failsafe;
+		const int caller = 301;
+		ActionOptions opt{Action::Warn};
+		failsafe.callCheckFailsafe(caller, false, true, opt);
+		failsafe.callCheckFailsafe(caller, true, true, opt);
+		failsafe.callCheckFailsafe(caller, true, true, opt);
+	}
+
+	// 2. Lines 401, 403, 409: removeAction branches
+	{
+		FailsafeStudentTester failsafe;
+		ActionOptions &act = failsafe.getActionSlot(0);
+		act.id = 302;
+		act.action = Action::Hold;
+		act.clear_condition = ClearCondition::OnDisarm;
+		act.cannotBeDeferred();
+		failsafe.setDeferFailsafesDirect(true);
+
+		// Case A: state_failure is true -> hits line 409 true
+		act.state_failure = true;
+		failsafe.callRemoveAction(act);
+		EXPECT_TRUE(act.valid());
+		EXPECT_FALSE(act.state_failure);
+
+		// Case B: state_failure is already false -> hits line 409 false
+		act.state_failure = false;
+		failsafe.callRemoveAction(act);
+		EXPECT_TRUE(act.valid());
+	}
+
+	// 3. Line 426: removeNonActivatedActions with state_failure == false
+	{
+		FailsafeStudentTester failsafe;
+		ActionOptions act{Action::Hold};
+		act.id = 305;
+		act.clear_condition = ClearCondition::OnDisarm;
+		act.state_failure = false;
+		act.activated = false;
+		failsafe.getActionSlot(0) = act;
+
+		failsafe.callRemoveNonActivatedActions();
+	}
+
+	// 4. Line 483: _defer_failsafes true, allow_failsafe_to_be_deferred true, but selected_action == None
+	{
+		FailsafeStudentTester failsafe;
+		failsafe.setDeferFailsafesDirect(true);
+		failsafe.setFallbackCheckCallback([](const failsafe_flags_s &, uint8_t) {
+			return Action::None;
+		});
+		SelectedActionState res{};
+		failsafe.callGetSelectedAction(_default_state, failsafe_flags_s{}, false, false, res);
+		EXPECT_EQ(res.action, Action::None);
+	}
+
+	// 5. Line 495: _current_delay > 0, but _user_takeover_active == true
+	{
+		FailsafeStudentTester failsafe;
+		failsafe.setCurrentDelay(3000000_us);
+		ActionOptions opt(Action::RTL);
+		failsafe.callCheckFailsafe(306, false, true, opt);
+		failsafe.setUserTakeoverActiveDirect(true);
+		SelectedActionState res{};
+		failsafe.callGetSelectedAction(_default_state, failsafe_flags_s{}, false, false, res);
+		EXPECT_EQ(res.delayed_action, Action::None);
+	}
+
+	// 6. Line 508: allow_user_takeover == AlwaysModeSwitchOnly with takeover inactive & no mode switch
+	{
+		FailsafeStudentTester failsafe;
+		ActionOptions opt(Action::RTL);
+		opt.allowUserTakeover(UserTakeoverAllowed::AlwaysModeSwitchOnly);
+		failsafe.callCheckFailsafe(307, false, true, opt);
+		SelectedActionState res{};
+		failsafe.callGetSelectedAction(_default_state, failsafe_flags_s{}, false, false, res);
+		EXPECT_FALSE(res.user_takeover);
+	}
+}
+
+// ============================================================================
+// TC-FS-34: notifyUser coverage across all notification event branches (lines 185-298)
+// Coverage targets: framework.cpp:185-298
+// ============================================================================
+TEST_F(FailsafeStudentTest, TC_FS_34_NotifyUserAllBranches)
+{
+	FailsafeStudentTester failsafe;
+	const uint8_t mode = vehicle_status_s::NAVIGATION_STATE_POSCTL;
+
+	// 1. Callback path (lines 173-175)
+	bool callback_called = false;
+	failsafe.setOnNotifyUserCallback([](void *arg) {
+		*static_cast<bool *>(arg) = true;
+	}, &callback_called);
+
+	failsafe.callNotifyUser(mode, Action::Warn, Action::None, Cause::Generic);
+	EXPECT_TRUE(callback_called);
+
+	// Reset callback to nullptr to cover line 173 false branch
+	failsafe.setOnNotifyUserCallback(nullptr, nullptr);
+
+	// 2. Delayed Hold with non-generic cause (lines 208-212)
+	failsafe.callNotifyUser(mode, Action::Hold, Action::RTL, Cause::BatteryLow);
+
+	// 3. Delayed Hold with generic cause (lines 195-204)
+	failsafe.callNotifyUser(mode, Action::Hold, Action::RTL, Cause::Generic);
+
+	// 4. Non-delayed Warn with specific battery causes (lines 253-270)
+	failsafe.callNotifyUser(mode, Action::Warn, Action::None, Cause::BatteryLow);
+	failsafe.callNotifyUser(mode, Action::Warn, Action::None, Cause::BatteryCritical);
+	failsafe.callNotifyUser(mode, Action::Warn, Action::None, Cause::BatteryEmergency);
+	failsafe.callNotifyUser(mode, Action::Warn, Action::None, Cause::RemainingFlightTimeLow);
+
+	// 5. Non-delayed Warn with non-battery specific cause (lines 276-280)
+	failsafe.callNotifyUser(mode, Action::Warn, Action::None, Cause::ManualControlLoss);
+	failsafe.callNotifyUser(mode, Action::Warn, Action::None, Cause::GCSConnectionLoss);
+
+	// 6. Non-delayed Action != Warn with specific cause (lines 283-290, 294)
+	failsafe.callNotifyUser(mode, Action::RTL, Action::None, Cause::ManualControlLoss);
+	failsafe.callNotifyUser(mode, Action::Land, Action::None, Cause::BatteryCritical);
+
+	// 7. Non-delayed generic cause actions (lines 220-250)
+	failsafe.callNotifyUser(mode, Action::Warn, Action::None, Cause::Generic);
+	failsafe.callNotifyUser(mode, Action::Descend, Action::None, Cause::Generic);
+	failsafe.callNotifyUser(mode, Action::FallbackAltCtrl, Action::None, Cause::Generic);
+	failsafe.callNotifyUser(mode, Action::FallbackStab, Action::None, Cause::Generic);
+	failsafe.callNotifyUser(mode, Action::RTL, Action::None, Cause::Generic);
+
+	// Cover framework.h modifyUserIntendedMode default virtual implementation
+	EXPECT_EQ(failsafe.modifyUserIntendedMode(Action::None, Action::Warn, 12), 12);
+}
