+	// Update 2: Omit check. Action must be removed by removeNonActivatedActions
+	include_check = false;
+	failsafe.update(1_s + 10_ms, _default_state, false, false, flags);
+	EXPECT_EQ(failsafe.selectedAction(), FailsafeBase::Action::None);
