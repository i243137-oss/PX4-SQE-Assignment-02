+// TC-FS-01: Public mapping - actionStr covering all enum values and invalid
+// Obligation: OBL-FS-001
+// ============================================================================
+TEST_F(FailsafeStudentTest, TC_FS_01_ActionStrMappings)
+{
+	EXPECT_STREQ(FailsafeBase::actionStr(FailsafeBase::Action::None), "None");
+	EXPECT_STREQ(FailsafeBase::actionStr(FailsafeBase::Action::Warn), "Warn");
+	EXPECT_STREQ(FailsafeBase::actionStr(FailsafeBase::Action::FallbackPosCtrl), "Fallback to PosCtrl");
+	EXPECT_STREQ(FailsafeBase::actionStr(FailsafeBase::Action::FallbackAltCtrl), "Fallback to AltCtrl");
+	EXPECT_STREQ(FailsafeBase::actionStr(FailsafeBase::Action::FallbackStab), "Fallback to Stabilized");
+	EXPECT_STREQ(FailsafeBase::actionStr(FailsafeBase::Action::Hold), "Hold");
+	EXPECT_STREQ(FailsafeBase::actionStr(FailsafeBase::Action::RTL), "RTL");
+	EXPECT_STREQ(FailsafeBase::actionStr(FailsafeBase::Action::Land), "Land");
+	EXPECT_STREQ(FailsafeBase::actionStr(FailsafeBase::Action::Descend), "Descend");
+	EXPECT_STREQ(FailsafeBase::actionStr(FailsafeBase::Action::Disarm), "Disarm");
+	EXPECT_STREQ(FailsafeBase::actionStr(FailsafeBase::Action::Terminate), "Terminate");
+	EXPECT_STREQ(FailsafeBase::actionStr(FailsafeBase::Action::Count), "(invalid)");
+	EXPECT_STREQ(FailsafeBase::actionStr(static_cast<FailsafeBase::Action>(255)), "(invalid)");
+	EXPECT_STREQ(FailsafeBase::actionStr(static_cast<FailsafeBase::Action>(42)), "(invalid)");
