+// ============================================================================
+// TC-FS-09: updateDelay boundary subtraction and clamping
+// Obligation: OBL-FS-010
+// ============================================================================
+TEST_F(FailsafeStudentTest, TC_FS_09_UpdateDelayBoundaries)
+{
+	FailsafeStudentTester failsafe;
+	failsafe.setCurrentDelay(5_s);
+
